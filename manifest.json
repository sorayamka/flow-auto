{
  "manifest_version": 3,
  "name": "Flow Auto",
  "description": "Threads → выбор фото → автопрогон через Google Flow с вашим промтом → автосохранение результатов",
  "version": "0.1.10",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads",
    "declarativeNetRequest",
    "sidePanel",
    "tabs",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://www.threads.com/*",
    "https://www.threads.net/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background/sw.js"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Flow Auto"
  },
  "content_scripts": [
    {
      "matches": ["https://labs.google/*", "https://flow.google.com/*"],
      "js": ["content/flow-driver.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.threads.com/*", "https://www.threads.net/*"],
      "js": ["content/threads-fallback.js"],
      "run_at": "document_idle"
    }
  ]
}
